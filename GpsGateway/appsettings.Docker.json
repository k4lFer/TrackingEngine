{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Gps": {
    "Enabled": true,
    "TcpPort": 8090
  },
  "Redis": {
    "Configuration": "redis:6379",
    "StreamKey": "gps:positions:stream",
    "ConsumerGroup": "app-consumers",
    "MaxLength": 100000
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  }
}
